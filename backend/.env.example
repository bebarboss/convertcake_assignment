# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง

# Typhoon LLM (จำเป็น) สมัครได้ที่ https://opentyphoon.ai
TYPHOON_API_KEY=
TYPHOON_API_BASE=https://api.opentyphoon.ai/v1
TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct

# Supabase cache (ไม่ใส่ = ปิด cache) ใช้ service_role key
SUPABASE_URL=
SUPABASE_KEY=

# TikTok scraper
COOKIES_FILE=cookies.json
TOP_N=10
CAPTCHA_WAIT_SECONDS=90
MAX_CONCURRENT_BROWSERS=3

# ใช้กับ docker compose (service ngrok) เท่านั้น
NGROK_AUTHTOKEN=
